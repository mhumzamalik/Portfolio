# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and populate with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (Prisma & PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction connection pooler URL (e.g. Supabase connection pooler port 6543)
# Used by runtime application and database queries.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection string (port 5432)
# Used by Prisma CLI for migrations, introspection, and schema generation.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase (Authentication & Realtime)
# ------------------------------------------------------------------------------
# Public Supabase project API URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Supabase anonymous API key (Client & Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# Admin Account & Seeding (Used by scripts/seed-admin.ts)
# ------------------------------------------------------------------------------
# Email for the administrator account and contact form notification recipient
ADMIN_EMAIL="admin@example.com"

# Initial password used when running seed script (scripts/seed-admin.ts)
ADMIN_PASSWORD="replace-with-a-secure-admin-password"

# Optional: Full name displayed for the seeded admin user (defaults to "Admin")
ADMIN_NAME="Muhammad Hamza"

# ------------------------------------------------------------------------------
# Security & Two-Factor Authentication (2FA TOTP)
# ------------------------------------------------------------------------------
# 32+ character random secret used to encrypt 2FA secrets and sign session cookies
# Required in production. Generate using: openssl rand -base64 32
TOTP_ENCRYPTION_KEY="replace-with-a-secure-random-32-char-encryption-key"

# Optional: Issuer name displayed in authenticator apps (defaults to "Admin Portal")
TOTP_ISSUER="Hamza Portfolio Admin"

# ------------------------------------------------------------------------------
# Google reCAPTCHA v3 (Admin Login Security)
# ------------------------------------------------------------------------------
# Public reCAPTCHA v3 site key for client-side challenge execution
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-v3-site-key"

# Server-side reCAPTCHA v3 secret key for verifying verification tokens
RECAPTCHA_SECRET_KEY="your-recaptcha-v3-secret-key"

# ------------------------------------------------------------------------------
# AI Portfolio Assistant (Google Gemini API - Optional)
# ------------------------------------------------------------------------------
# API key for Google Gemini model (gemini-3.5-flash / gemini-2.0-flash)
# Get a key from Google AI Studio (https://aistudio.google.com/)
# If omitted, AI chatbot displays an informative configuration notice.
GEMINI_API_KEY="your-google-gemini-api-key"

# ------------------------------------------------------------------------------
# Email Service (Resend - Optional)
# ------------------------------------------------------------------------------
# Resend API key for sending email notifications on contact form submissions
# If omitted, contact messages are still saved to the database and emails are skipped.
RESEND_API_KEY="re_123456789_your_resend_api_key"
